{
  "schemaVersion": 1,
  "id": "cinderflask",
  "version": "${version}",
  "name": "Cinderflask",
  "description": "A flask of gold and blackened steel that swallows fuel and feeds a furnace one smelt at a time, so nothing burns to waste. Craft it empty, then take a spark from a firefly or a blaze.",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "https://github.com/${github_repo}",
    "sources": "https://github.com/${github_repo}",
    "issues": "https://github.com/${github_repo}/issues"
  },
  "license": "MIT",
  "icon": "assets/cinderflask/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.cinderflask.Cinderflask"
    ],
    "client": [
      "dev.cinderflask.client.CinderflaskClient"
    ],
    "fabric-datagen": [
      "dev.cinderflask.datagen.CinderflaskDataGenerator"
    ]
  },
  "mixins": [
    "cinderflask.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": ">=0.92.0",
    "minecraft": "~1.20.1",
    "java": ">=17"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.source": "https://github.com/${github_repo}",
        "modmenu.issues": "https://github.com/${github_repo}/issues"
      }
    }
  }
}
